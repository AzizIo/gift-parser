# Bot API bot used to send notifications
BOT_TOKEN=
ADMIN_ID=

# User API app credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional. If omitted, auth command asks for the phone interactively.
TELEGRAM_PHONE=

# Local Telethon session. NEVER upload this file to GitHub.
TELEGRAM_SESSION_PATH=data/telegram_market

DATABASE_PATH=data/gift_parser.sqlite3
POLL_INTERVAL_SECONDS=45
REQUEST_DELAY_SECONDS=0.25
RESALE_PAGE_SIZE=100
LOG_LEVEL=INFO
